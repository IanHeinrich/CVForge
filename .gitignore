# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Claude Code local tooling config (machine/environment-specific, not portable)
.claude/*
# ...except skills, which are the opposite: repo-specific knowledge meant to
# be shared, and read by any contributor's session. `run-app` is the one
# that matters — it carries how to launch this app headlessly, which the PR
# template asks for on anything under lib/features/studio/widgets/.
!.claude/skills/
# Dart MCP server config — command/env.PATH point at this machine's Flutter
# SDK install location, not portable across devs or OSes.
.mcp.json

# Working handover notes — internal, not for the public repo
/HANDOVER.md

# golden_toolkit failure-diff output (local debugging only)
test/golden/failures/

# A per-developer default (e.g. `exclude_tags: golden`, see CLAUDE.md's
# testing section) — must never be committed, since CI needs the golden
# tests to actually run on every PR.
/dart_test.yaml
