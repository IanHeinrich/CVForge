  "sectionLabelExperience": "Experiencia laboral",
  "sectionLabelHobbies": "Intereses y pasatiempos",
  "sectionLabelProjects": "Proyectos",
  "sectionLabelPublications": "Publicaciones",
  "sectionLabelReferences": "Referencias",
  "sectionLabelSkills": "Habilidades",
