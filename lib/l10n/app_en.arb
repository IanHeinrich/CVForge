    "description": "Region picker: one of the LATAMA4 market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionLatamA4Convention5": "Certified language proficiency is a primary screening filter, especially in Brazil: state TOEFL, IELTS, DELE, or CELPE-Bras scores with the date taken.",
  "@regionLatamA4Convention5": {
    "description": "Region picker: one of the LATAMA4 market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionLatamA4Convention6": "Name the institution for every qualification; university reputation is read closely.",
  "@regionLatamA4Convention6": {
    "description": "Region picker: one of the LATAMA4 market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionLatamA4Convention7": "If writing in English, US spelling is the regional norm.",
  "@regionLatamA4Convention7": {
    "description": "Region picker: one of the LATAMA4 market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
