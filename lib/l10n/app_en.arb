  "regionNordicsConvention1": "One to two pages. A long CV reads as poor editing.",
  "@regionNordicsConvention1": {
    "description": "Region picker: one of the NORDICS market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionNordicsConvention2": "A photograph is neither expected nor unwelcome. Include one only if it is genuinely professional.",
  "@regionNordicsConvention2": {
    "description": "Region picker: one of the NORDICS market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionNordicsConvention3": "Keep personal data minimal: name, contact, city. No date of birth, marital status, or national ID number.",
  "@regionNordicsConvention3": {
    "description": "Region picker: one of the NORDICS market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionNordicsConvention4": "Frame achievements around the team and the outcome rather than personal heroics.",
  "@regionNordicsConvention4": {
    "description": "Region picker: one of the NORDICS market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionNordicsConvention5": "State Scandinavian language proficiency explicitly with a level (\"Swedish — B2\"). It moves the needle.",
  "@regionNordicsConvention5": {
