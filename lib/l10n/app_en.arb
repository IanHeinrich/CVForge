  },
  "regionLatamA4DisplayName": "Brazil & Southern Cone",
  "@regionLatamA4DisplayName": {
    "description": "Region picker: the name of the LATAMA4 market grouping."
  },
  "regionLatamA4LengthNote": "Two to three pages.",
  "@regionLatamA4LengthNote": {
