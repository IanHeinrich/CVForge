  "atsFindingColumnCrushBody": "\"{left}\" and \"{right}\" sit on the same line with a wide gap between them. A text extractor that reads by position rather than by the document's own structure may merge these into one run, e.g. \"{merged}\".",
  "@atsFindingColumnCrushBody": {
    "description": "ATS check finding body for a suspected multi-column layout. {left} and {right} are verbatim excerpts from the user's own PDF and must not be translated; {merged} shows the two run together to demonstrate the failure.",
    "placeholders": {
      "left": {
        "type": "String",
        "example": "Senior Engineer"
      },
      "right": {
        "type": "String",
        "example": "2019-2023"
      },
      "merged": {
        "type": "String",
        "example": "Senior Engineer2019-2023"
      }
    }
  },
  "atsFindingColumnCrushTitle": "Possible multi-column layout",
  "@atsFindingColumnCrushTitle": {
    "description": "ATS check finding title: two text runs sit on one line with a wide gap, which a position-sorting parser may merge incorrectly."
  },
  "atsFindingDroppedCharsBody": "{count, plural, =1{Found 1 short run where more space was used than the extracted characters account for} other{Found {count} short runs where more space was used than the extracted characters account for}} — a sign a symbol (often a bullet) silently failed to extract at all.",
  "@atsFindingDroppedCharsBody": {
    "description": "ATS check finding body for characters that vanished during extraction.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "6"
      }
    }
  },
  "atsFindingDroppedCharsTitle": "Possible dropped characters",
  "@atsFindingDroppedCharsTitle": {
    "description": "ATS check finding title: a run used more horizontal space than its characters account for, so a glyph likely failed to extract."
  },
  "atsFindingGarbledBody": "{count, plural, =1{Found 1 character that failed to decode to readable text} other{Found {count} characters that failed to decode to readable text}} — the font used likely has a missing or broken character map. An ATS will see this text as garbage.",
  "@atsFindingGarbledBody": {
    "description": "ATS check finding body for undecodable characters.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "14"
      }
    }
  },
  "atsFindingGarbledTitle": "Unreadable characters found",
  "@atsFindingGarbledTitle": {
    "description": "ATS check finding title: characters that failed to decode to readable text."
  },
  "atsFindingIconFontBody": "{count, plural, =1{Found 1 character from a private-use code range} other{Found {count} characters from a private-use code range}} embedded within words — a common sign of an icon or symbol font (e.g. Wingdings) rather than real text, which most ATS parsers will render as blanks or gibberish.",
  "@atsFindingIconFontBody": {
    "description": "ATS check finding body for icon-font glyphs. 'Wingdings' is a font name and stays untranslated.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "atsFindingIconFontTitle": "Possible icon/symbol font glyphs in text",
  "@atsFindingIconFontTitle": {
    "description": "ATS check finding title: private-use-area codepoints inside words, typically an icon font used as if it were text."
  },
  "atsFindingMissingHeadingBody": "{section, select, experience{Couldn't find a heading for Experience anywhere in the document.} education{Couldn't find a heading for Education anywhere in the document.} skills{Couldn't find a heading for Skills anywhere in the document.} other{Couldn't find a heading for {section} anywhere in the document.}} Some ATS software structures a resume by matching canonical section headings, and may file this content as unstructured text if the heading is missing or phrased unusually.",
  "@atsFindingMissingHeadingBody": {
    "description": "ATS check finding body for a missing canonical section heading. The first sentence varies by section; the explanation after it is shared.",
    "placeholders": {
      "section": {
        "type": "String",
        "example": "experience"
      }
    }
  },
  "atsFindingMissingHeadingTitle": "{section, select, experience{No Experience section detected} education{No Education section detected} skills{No Skills section detected} other{No {section} section detected}}",
  "@atsFindingMissingHeadingTitle": {
    "description": "ATS check finding title for a canonical CV section whose heading could not be found. The branch names a section of a CV. Note the app searches the PDF for ENGLISH heading keywords because the CVs it produces are English, so this reports on an English document even in a translated UI.",
    "placeholders": {
      "section": {
        "type": "String",
        "example": "experience"
      }
    }
  },
  "atsFindingNoEmailBody": "Couldn't find an email address in the extracted text or in any clickable link. Most ATS software requires a readable email address to file an application.",
