  "regionAnzConvention1": "Two to three pages is normal and expected. A one-page resume reads as thin here.",
  "@regionAnzConvention1": {
    "description": "Region picker: one of the ANZ market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionAnzConvention2": "No photograph, date of birth, or marital status.",
  "@regionAnzConvention2": {
    "description": "Region picker: one of the ANZ market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionAnzConvention3": "State your work rights in the header — \"Australian citizen\", \"NZ permanent resident\", \"482 visa\". Recruiters filter on this first.",
  "@regionAnzConvention3": {
    "description": "Region picker: one of the ANZ market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionAnzConvention4": "Include a dedicated \"Referees\" section with two named referees, or state that details are available on request.",
  "@regionAnzConvention4": {
    "description": "Region picker: one of the ANZ market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionAnzConvention5": "If writing in English, use Australian spelling: organised, centre, analyse. Be consistent — some sectors accept -ize, but mixing the two is what gets noticed.",
  "@regionAnzConvention5": {
    "description": "Region picker: one of the ANZ market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionAnzConvention6": "Give more context per role than a US résumé would: company scope, reporting lines, team size, budget.",
  "@regionAnzConvention6": {
    "description": "Region picker: one of the ANZ market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionAnzCoverage": "Australia, New Zealand",
  "@regionAnzCoverage": {
    "description": "Region picker: which countries the ANZ grouping covers. Use each country's own name in the target language."
  },
  "regionAnzDisplayName": "Australia & New Zealand",
  "@regionAnzDisplayName": {
    "description": "Region picker: the name of the ANZ market grouping."
  },
  "regionAnzLengthNote": "Two to three pages mid-career; three to five for executive roles.",
  "@regionAnzLengthNote": {
    "description": "Region picker: how long a CV should run in the ANZ market."
  },
  "regionAnzToneNote": "Context-rich and concrete. Explain what the organisation does, the size of your remit, then the outcome — Australasian readers expect more surrounding detail than a US résumé gives.",
  "@regionAnzToneNote": {
    "description": "Region picker: how achievements should be framed in the ANZ market."
  },
  "regionDachConvention1": "Around two thirds of German-speaking employers still expect a professional headshot, top right. Upload one in the Vault and choose a template that includes one; the rest leave it off.",
  "@regionDachConvention1": {
    "description": "Region picker: one of the DACH market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionDachConvention2": "Date and place of birth, nationality, and sometimes marital status are traditional in the personal-details block, and CVForge has no field for any of them. Younger and international employers increasingly omit them: omitting is safe, including is conventional.",
  "@regionDachConvention2": {
    "description": "Region picker: one of the DACH market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionDachConvention3": "The chronology must be gap-free and month-precise. An unexplained gap reads as concealment; label it plainly (\"Parental leave\", \"Further education\").",
  "@regionDachConvention3": {
    "description": "Region picker: one of the DACH market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionDachConvention4": "Education stays prominent throughout your career, with the institution named and grades given.",
  "@regionDachConvention4": {
    "description": "Region picker: one of the DACH market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionDachConvention5": "Certificates (Zeugnisse) are attached as a separate document; the Lebenslauf references them rather than reproducing them.",
  "@regionDachConvention5": {
    "description": "Region picker: one of the DACH market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionDachConvention6": "If writing in English, use British spelling.",
  "@regionDachConvention6": {
    "description": "Region picker: one of the DACH market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionDachCoverage": "Germany, Austria, Switzerland",
  "@regionDachCoverage": {
    "description": "Region picker: which countries the DACH grouping covers. Use each country's own name in the target language."
  },
  "regionDachDisplayName": "DACH",
  "@regionDachDisplayName": {
    "description": "Region picker: the name of the DACH market grouping."
  },
  "regionDachLengthNote": "Two to three pages, tabular and complete.",
  "@regionDachLengthNote": {
    "description": "Region picker: how long a CV should run in the DACH market."
  },
  "regionDachToneNote": "Formal, factual, complete. Understatement over salesmanship, verifiable facts over adjectives.",
  "@regionDachToneNote": {
    "description": "Region picker: how achievements should be framed in the DACH market."
  },
  "regionEuropeConvention1": "One to two pages. France in particular expects a single page for anything under about fifteen years' experience.",
  "@regionEuropeConvention1": {
    "description": "Region picker: one of the EUROPE market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionEuropeConvention2": "A photograph is common in France, Spain, Italy, and Portugal, and unusual elsewhere. For an international or multinational application, leave it off.",
  "@regionEuropeConvention2": {
    "description": "Region picker: one of the EUROPE market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionEuropeConvention3": "Keep personal data minimal for a multinational. A domestic French or Southern European employer may still expect date of birth and nationality.",
  "@regionEuropeConvention3": {
    "description": "Region picker: one of the EUROPE market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionEuropeConvention4": "List language proficiencies with CEFR levels (A1–C2). European recruiters read these precisely.",
  "@regionEuropeConvention4": {
    "description": "Region picker: one of the EUROPE market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionEuropeConvention5": "Southern European employers tolerate longer CVs — four or five pages is seen — but a tighter document still reads better.",
  "@regionEuropeConvention5": {
    "description": "Region picker: one of the EUROPE market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionEuropeConvention6": "If writing in English, use British spelling. A local-language version is worth producing for a domestic application.",
  "@regionEuropeConvention6": {
    "description": "Region picker: one of the EUROPE market's CV conventions, rendered as a bullet and read on its own. A complete sentence."
  },
  "regionEuropeCoverage": "France, Benelux, Southern Europe, and multinationals",
  "@regionEuropeCoverage": {
    "description": "Region picker: which countries the EUROPE grouping covers. Use each country's own name in the target language."
  },
  "regionEuropeDisplayName": "Europe — international",
  "@regionEuropeDisplayName": {
    "description": "Region picker: the name of the EUROPE market grouping."
  },
  "regionEuropeLengthNote": "One to two pages. France prefers one; Southern Europe tolerates more.",
  "@regionEuropeLengthNote": {
    "description": "Region picker: how long a CV should run in the EUROPE market."
  },
  "regionEuropeToneNote": "Professional and measured. Concrete results, without the hard-sell register of a US résumé.",
  "@regionEuropeToneNote": {
    "description": "Region picker: how achievements should be framed in the EUROPE market."
  },
  "regionLatamA4Convention1": "A4 is standard across Brazil, Argentina, Uruguay, and Peru. For Mexico, Colombia, Chile, or Central America, pick \"Mexico, Colombia & Chile\" instead — those markets use US Letter.",
  "@regionLatamA4Convention1": {
